<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MW.Identity.Sso</RootNamespace>
    <AssemblyName>MW.Identity.Sso</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Dr.MadWill</Authors>
    <RepositoryUrl>https://github.com/DrMadWill/MW.Extensions</RepositoryUrl>
    <RepositoryType>Extensions</RepositoryType>
    <Description>MyBid admin SSO relying-party: challenge to Identity /sso/authorize, callback gRPC code exchange, shared parent-domain cookie sign-in, single logout.</Description>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.27.2" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.65.0" />
    <PackageReference Include="Grpc.Tools" Version="2.65.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MW.Identity.Token" Version="1.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="8.0.10" />
    <!-- Pin patched transitive: DataProtection.StackExchangeRedis 8.0.10 pulls System.Security.Cryptography.Xml
         8.0.2 which has High advisory GHSA-37gx-xxp4-5rgx. Override with the patched build. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\sso_introspection.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
